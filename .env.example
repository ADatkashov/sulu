# Copy to .env (never commit). Backend reads these as environment variables.
SULU_DB_URL=jdbc:postgresql://localhost:5432/sulu
SULU_DB_USER=sulu
SULU_DB_PASSWORD=change-me
# >= 32 bytes. REQUIRED outside the 'dev' profile.
SULU_JWT_SECRET=
SULU_CORS_ORIGINS=https://app.example.com
SULU_STORAGE_DIR=./uploads
# First platform admin (created at startup if absent)
SULU_ADMIN_EMAIL=
SULU_ADMIN_PASSWORD=
# Payments: leave simulated OFF in production. Webhook secret is required for real providers.
SULU_PAYMENTS_SIMULATED=false
SULU_PAYMENT_WEBHOOK_SECRET=
# Demo data: development only
SULU_SEED_DEMO=false
